generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= AUTH / USERS =================

enum Role {
  CLIENT
  MUSICIAN
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          Role       @default(CLIENT)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified DateTime?
  phone         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client          Client?
  musician        Musician?
  reviewsGiven    Review[]      @relation("Reviewer")
  reviewsReceived Review[]      @relation("Reviewee")
  notifications   Notification[]
  messagesSent    Message[]     @relation("MessageSender")
  reportsMade     Report[]      @relation("Reporter")
  reportsReceived Report[]      @relation("Reported")
  adminActions    AdminAction[] @relation("AdminActor")
  auditLogs       AuditLog[]    @relation("AuditLogActor")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ================= CLIENT =================

model Client {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  events   Event[]
  bookings Booking[]
}

// ================= MUSICIAN =================

model Musician {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  stageName         String
  bio               String?
  photoUrl          String?
  // Localização aproximada (privacidade - ADR-006)
  latitude          Float?
  longitude         Float?
  serviceRadiusKm   Float    @default(50)
  priceMin          Float?
  priceMax          Float?
  verified          Boolean  @default(false)
  stripeAccountId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills        MusicianSkill[]
  genres        MusicianGenre[]
  availability  Availability[]
  bookings      Booking[]        @relation("MusicianBookings")
  media         Media[]
  verifications Verification[]
  payouts       Payout[]
}

// ================= CATÁLOGO DE SKILLS =================

enum SkillCategory {
  INSTRUMENT
  FUNCTION
  VOCAL
}

model Skill {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  category  SkillCategory
  // Sinônimos e variações (plural, nomes populares) - ADR-005
  synonyms  String[]
  active    Boolean       @default(true)

  musicians MusicianSkill[]
}

model MusicianSkill {
  id         String   @id @default(cuid())
  musicianId String
  skillId    String
  level      String? // ex.: iniciante, intermediário, profissional
  musician   Musician @relation(fields: [musicianId], references: [id])
  skill      Skill    @relation(fields: [skillId], references: [id])

  @@unique([musicianId, skillId])
}

// ================= GÊNEROS =================

model Genre {
  id        String          @id @default(cuid())
  name      String          @unique
  musicians MusicianGenre[]
}

model MusicianGenre {
  id         String   @id @default(cuid())
  musicianId String
  genreId    String
  musician   Musician @relation(fields: [musicianId], references: [id])
  genre      Genre    @relation(fields: [genreId], references: [id])

  @@unique([musicianId, genreId])
}

// ================= MÍDIAS =================

model Media {
  id         String   @id @default(cuid())
  musicianId String
  musician   Musician @relation(fields: [musicianId], references: [id])
  type       String // VIDEO | AUDIO | IMAGE
  url        String
  createdAt  DateTime @default(now())
}

// ================= EVENTO =================

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  PARTY
  OTHER
}

// ================= EVENTOS =================

model Event {
  id            String    @id @default(cuid())
  clientId      String
  title         String
  type          EventType @default(OTHER)
  date          DateTime
  durationHours Float     @default(4)
  locationLat   Float
  locationLng   Float
  addressLabel  String?
  notes         String?
  budget        Float?
  status        String    @default("OPEN") // OPEN | BOOKED | CLOSED | CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  bookings Booking[]

  @@index([clientId])
  @@index([date])
}

model Booking {
  id         String   @id @default(cuid())
  clientId   String
  eventId    String
  musicianId String

  status        BookingStatus @default(REQUESTED)
  value         Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client         Client    @relation(fields: [clientId], references: [id])
  musician       Musician  @relation("MusicianBookings", fields: [musicianId], references: [id])
  event          Event     @relation(fields: [eventId], references: [id])
  reviews        Review[]
  payment        Payment?
  messages       Message[]
  notifications Notification[]

  @@index([musicianId, status])
  @@index([clientId])
}

enum BookingStatus {
  REQUESTED
  PENDING_MUSICIAN
  ACCEPTED
  REJECTED
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DISPUTED
}

// ================= DISPONIBILIDADE / AGENDA =================

model Availability {
  id         String   @id @default(cuid())
  musicianId String
  musician   Musician @relation(fields: [musicianId], references: [id])
  startAt    DateTime
  endAt      DateTime
  blocked    Boolean  @default(false) // data bloqueada

  @@index([musicianId, startAt])
}

// ================= AVALIAÇÕES =================

enum ReviewType {
  CLIENT_TO_MUSICIAN
  MUSICIAN_TO_CLIENT
}

model Review {
  id        String     @id @default(cuid())
  bookingId String
  reviewerId String
  revieweeId String
  type      ReviewType
  rating    Int // 1-5
  comment   String?
  createdAt DateTime   @default(now())

  booking   Booking    @relation(fields: [bookingId], references: [id])
  reviewer  User       @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee  User       @relation("Reviewee", fields: [revieweeId], references: [id])

  // Impede múltiplas avaliações indevidas
  @@unique([bookingId, reviewerId, type])
}

// ================= PAGAMENTOS (ESCROW) =================

enum PaymentStatus {
  PENDING
  CAPTURED
  ON_HOLD // retido na plataforma
  FAILED
  RELEASED
  REFUNDED
  DISPUTED
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  stripeId      String        @unique
  amount        Float
  platformFee   Float
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payout Payout?
}

model Payout {
  id        String   @id @default(cuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  musicianId String
  musician  Musician @relation(fields: [musicianId], references: [id])
  amount    Float
  status    String // PENDING | PAID | FAILED
  createdAt DateTime @default(now())
}

// ================= NOTIFICAÇÕES =================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // NEW_REQUEST, ACCEPTED, PAYMENT, REMINDER, MESSAGE...
  title     String
  body      String
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ================= MENSAGENS (CHAT) =================

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  sender  User    @relation("MessageSender", fields: [senderId], references: [id])
}

// ================= DENÚNCIAS =================

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String
  status      String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  reported User @relation("Reported", fields: [reportedId], references: [id])
}

// ================= VERIFICAÇÃO =================

model Verification {
  id         String   @id @default(cuid())
  musicianId String
  musician   Musician @relation(fields: [musicianId], references: [id])
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  documentUrl String?
  createdAt  DateTime @default(now())
}

// ================= ADMIN =================

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id])
  targetUserId String
  action     String // BLOCK, SUSPEND, VERIFY, MODERATE
  details    String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id])
}
